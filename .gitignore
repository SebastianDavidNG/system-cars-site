# Ignore Docker volumes and temporary files
db_data/
*.log
.DS_Store
node_modules/

# WordPress auto-generated / non-source files
wp-content/uploads/
wp-content/languages/
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
.opencode

# All-in-One WP Migration backups (too large for GitHub)
wp-content/ai1wm-backups/*.wpress
wp-content/ai1wm-backups/*.wpress.*
